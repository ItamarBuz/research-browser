{
  "openapi": "3.1.0",
  "info": {
    "title": "Research Browser Engine",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/system": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get System",
        "operationId": "getSystem",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/system/tier-override": {
      "put": {
        "tags": [
          "system"
        ],
        "summary": "Set Tier Override",
        "operationId": "setTierOverride",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TierOverrideRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "List Models",
        "operationId": "listModels",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/models/{model_id}/download": {
      "post": {
        "tags": [
          "models"
        ],
        "summary": "Start Model Download",
        "operationId": "startModelDownload",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/library": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "Get Library",
        "operationId": "getLibrary",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryState"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/library/documents": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Import Documents",
        "operationId": "importDocuments",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_importDocuments"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ImportResult"
                  },
                  "type": "array",
                  "title": "Response Importdocuments"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/library/documents/{document_id}": {
      "delete": {
        "tags": [
          "library"
        ],
        "summary": "Delete Document",
        "operationId": "deleteDocument",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/library/reindex": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Reindex",
        "operationId": "reindexLibrary",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexStatus"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/library/search": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Search",
        "operationId": "searchLibrary",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Body_importDocuments": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_importDocuments"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "SHA-256 of the file, so the same PDF is never stored twice"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "en",
                  "he",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count",
            "default": 0
          },
          "passage_count": {
            "type": "integer",
            "title": "Passage Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "file_name",
          "size_bytes",
          "added_at",
          "status",
          "metadata"
        ],
        "title": "Document"
      },
      "DocumentHit": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/PassageHit"
            },
            "type": "array",
            "title": "Passages"
          }
        },
        "type": "object",
        "required": [
          "document",
          "score",
          "passages"
        ],
        "title": "DocumentHit"
      },
      "DocumentMetadata": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authors"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "DocumentMetadata"
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "queued",
          "parsing",
          "indexing",
          "ready",
          "failed"
        ],
        "title": "DocumentStatus"
      },
      "GpuInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "backend": {
            "type": "string",
            "enum": [
              "cuda",
              "metal"
            ],
            "title": "Backend"
          },
          "memory_mb": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Memory Mb",
            "description": "Dedicated VRAM, or the usable share of unified memory"
          },
          "unified_memory": {
            "type": "boolean",
            "title": "Unified Memory",
            "description": "True when the GPU shares system RAM (Apple Silicon)"
          }
        },
        "type": "object",
        "required": [
          "name",
          "backend",
          "memory_mb",
          "unified_memory"
        ],
        "title": "GpuInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HardwareProfile": {
        "properties": {
          "os": {
            "type": "string",
            "title": "Os"
          },
          "arch": {
            "type": "string",
            "title": "Arch"
          },
          "cpu_physical_cores": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Cpu Physical Cores"
          },
          "cpu_logical_cores": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Cpu Logical Cores"
          },
          "total_ram_mb": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Ram Mb"
          },
          "available_ram_mb": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Available Ram Mb"
          },
          "gpus": {
            "items": {
              "$ref": "#/components/schemas/GpuInfo"
            },
            "type": "array",
            "title": "Gpus"
          }
        },
        "type": "object",
        "required": [
          "os",
          "arch",
          "cpu_physical_cores",
          "cpu_logical_cores",
          "total_ram_mb",
          "available_ram_mb",
          "gpus"
        ],
        "title": "HardwareProfile"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "api_version": {
            "type": "integer",
            "title": "Api Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "api_version"
        ],
        "title": "HealthResponse"
      },
      "ImportResult": {
        "properties": {
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "document": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Document"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "file_name"
        ],
        "title": "ImportResult"
      },
      "IndexStatus": {
        "properties": {
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "model_ready": {
            "type": "boolean",
            "title": "Model Ready"
          },
          "ready_documents": {
            "type": "integer",
            "title": "Ready Documents"
          },
          "indexed_documents": {
            "type": "integer",
            "title": "Indexed Documents"
          },
          "pending_documents": {
            "type": "integer",
            "title": "Pending Documents",
            "description": "Parsed documents missing from the active index"
          },
          "busy": {
            "type": "boolean",
            "title": "Busy",
            "description": "Documents are being imported or indexed right now"
          }
        },
        "type": "object",
        "required": [
          "embedding_model",
          "model_ready",
          "ready_documents",
          "indexed_documents",
          "pending_documents",
          "busy"
        ],
        "title": "IndexStatus"
      },
      "LibraryDocument": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "SHA-256 of the file, so the same PDF is never stored twice"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "en",
                  "he",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count",
            "default": 0
          },
          "passage_count": {
            "type": "integer",
            "title": "Passage Count",
            "default": 0
          },
          "searchable": {
            "type": "boolean",
            "title": "Searchable",
            "description": "Indexed with the active embedding model"
          }
        },
        "type": "object",
        "required": [
          "id",
          "file_name",
          "size_bytes",
          "added_at",
          "status",
          "metadata",
          "searchable"
        ],
        "title": "LibraryDocument"
      },
      "LibraryState": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/LibraryDocument"
            },
            "type": "array",
            "title": "Documents"
          },
          "index": {
            "$ref": "#/components/schemas/IndexStatus"
          }
        },
        "type": "object",
        "required": [
          "documents",
          "index"
        ],
        "title": "LibraryState"
      },
      "ModelInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/ModelRole"
          },
          "license": {
            "type": "string",
            "title": "License"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "tiers": {
            "items": {
              "$ref": "#/components/schemas/Tier"
            },
            "type": "array",
            "title": "Tiers"
          },
          "recommended": {
            "type": "boolean",
            "title": "Recommended"
          },
          "state": {
            "$ref": "#/components/schemas/ModelState"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "license",
          "size_bytes",
          "tiers",
          "recommended",
          "state"
        ],
        "title": "ModelInfo"
      },
      "ModelList": {
        "properties": {
          "tier": {
            "$ref": "#/components/schemas/Tier"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "tier",
          "models"
        ],
        "title": "ModelList"
      },
      "ModelRole": {
        "type": "string",
        "enum": [
          "embedder",
          "reranker",
          "nli",
          "llm"
        ],
        "title": "ModelRole"
      },
      "ModelState": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ModelStatus"
          },
          "downloaded_bytes": {
            "type": "integer",
            "title": "Downloaded Bytes"
          },
          "total_bytes": {
            "type": "integer",
            "title": "Total Bytes"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "downloaded_bytes",
          "total_bytes"
        ],
        "title": "ModelState"
      },
      "ModelStatus": {
        "type": "string",
        "enum": [
          "not_downloaded",
          "downloading",
          "ready",
          "failed"
        ],
        "title": "ModelStatus"
      },
      "PassageHit": {
        "properties": {
          "passage_id": {
            "type": "string",
            "title": "Passage Id"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "similarity": {
            "type": "number",
            "title": "Similarity",
            "description": "Cosine similarity between query and passage"
          }
        },
        "type": "object",
        "required": [
          "passage_id",
          "page",
          "text",
          "score",
          "similarity"
        ],
        "title": "PassageHit"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "he",
              "cross"
            ],
            "title": "Language",
            "default": "cross"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "query_language": {
            "type": "string",
            "enum": [
              "en",
              "he",
              "other"
            ],
            "title": "Query Language"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/DocumentHit"
            },
            "type": "array",
            "title": "Results"
          },
          "took_ms": {
            "type": "integer",
            "title": "Took Ms"
          }
        },
        "type": "object",
        "required": [
          "query_language",
          "embedding_model",
          "results",
          "took_ms"
        ],
        "title": "SearchResponse"
      },
      "SystemInfo": {
        "properties": {
          "hardware": {
            "$ref": "#/components/schemas/HardwareProfile"
          },
          "tier": {
            "$ref": "#/components/schemas/TierDecision"
          },
          "resident_model_limit": {
            "type": "integer",
            "title": "Resident Model Limit"
          }
        },
        "type": "object",
        "required": [
          "hardware",
          "tier",
          "resident_model_limit"
        ],
        "title": "SystemInfo"
      },
      "Tier": {
        "type": "string",
        "enum": [
          "lite",
          "standard",
          "pro"
        ],
        "title": "Tier",
        "description": "Feature/model scale the engine runs at. Ordered from smallest to largest."
      },
      "TierDecision": {
        "properties": {
          "detected": {
            "$ref": "#/components/schemas/Tier"
          },
          "effective": {
            "$ref": "#/components/schemas/Tier"
          },
          "override_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "user",
                  "env"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Override Source"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/TierReason"
            },
            "type": "array",
            "title": "Reasons"
          }
        },
        "type": "object",
        "required": [
          "detected",
